<?xml version="1.0"?>
<robot name="simple_biped">

  <material name="blue">
    <color rgba="0.15 0.35 0.85 1"/>
  </material>
  <material name="dark">
    <color rgba="0.18 0.18 0.22 1"/>
  </material>

  <!-- Main body -->
  <link name="body">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.16 0.12 0.22"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.16 0.12 0.22"/></geometry>
    </collision>
  </link>

  <!-- Left upper leg -->
  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.10"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="body"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.045 -0.11"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="2" velocity="2"/>
  </joint>

  <!-- Left lower leg -->
  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.10"/>
      <mass value="0.20"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.1" upper="1.2" effort="2" velocity="2"/>
  </joint>

  <!-- Left foot -->
  <link name="left_foot">
    <inertial>
      <origin xyz="0.04 0 -0.02"/>
      <mass value="0.10"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 -0.02"/>
      <geometry><box size="0.14 0.07 0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.02"/>
      <geometry><box size="0.14 0.07 0.04"/></geometry>
    </collision>
  </link>

  <joint name="left_ankle" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="1" velocity="2"/>
  </joint>

  <!-- Right upper leg -->
  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.10"/>
      <mass value="0.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="body"/>
    <child link="right_thigh"/>
    <origin xyz="0 -0.045 -0.11"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="2" velocity="2"/>
  </joint>

  <!-- Right lower leg -->
  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.10"/>
      <mass value="0.20"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.1" upper="1.2" effort="2" velocity="2"/>
  </joint>

  <!-- Right foot -->
  <link name="right_foot">
    <inertial>
      <origin xyz="0.04 0 -0.02"/>
      <mass value="0.10"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 -0.02"/>
      <geometry><box size="0.14 0.07 0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 -0.02"/>
      <geometry><box size="0.14 0.07 0.04"/></geometry>
    </collision>
  </link>

  <joint name="right_ankle" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="1" velocity="2"/>
  </joint>

</robot>
